# Optional first-run bootstrap; /connect is the interactive alternative.
# Copy this file to .env, then replace the key and model placeholders.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_key_here
MODEL=your_model_id

# Optional isolation for local experiments (leave unset for normal usage).
# ZAPCODE_DATA_DIR=/absolute/path/to/disposable-zap-data
