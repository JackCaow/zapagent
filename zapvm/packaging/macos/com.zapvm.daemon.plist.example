<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zapvm.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/zapvm</string>
    <string>daemon</string>
    <string>run</string>
    <string>--config</string>
    <string>/Users/REPLACE_ME/.config/zapvm/daemon.json</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
