FROM node:22-alpine AS web-ui

WORKDIR /src/web/client/react
COPY web/client/react/package.json web/client/react/package-lock.json ./
RUN npm ci
COPY web/client/react ./
RUN npm run build

FROM golang:1.26.6-alpine3.23 AS build

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=0.3.0-beta.4

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web-ui /src/web/client/app/dist ./web/client/app/dist
RUN CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/zapvm-web ./cmd/zapvm-web

FROM alpine:3.22

RUN apk add --no-cache ca-certificates su-exec \
    && addgroup -S -g 10001 zapvm \
    && adduser -S -D -H -u 10001 -G zapvm zapvm

COPY --from=build /out/zapvm-web /usr/local/bin/zapvm-web
COPY packaging/railway/web-entrypoint.sh /usr/local/bin/zapvm-web-entrypoint
RUN chmod 0755 /usr/local/bin/zapvm-web /usr/local/bin/zapvm-web-entrypoint

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/zapvm-web-entrypoint"]
