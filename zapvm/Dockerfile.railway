FROM golang:1.26.6-alpine3.23 AS build

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=0.3.0-beta.4

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/zapvm-control ./cmd/zapvm-control \
    && CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -trimpath -ldflags="-s -w" \
    -o /out/zapvm-control-db ./cmd/zapvm-control-db

FROM alpine:3.22

RUN apk add --no-cache ca-certificates su-exec \
    && addgroup -S -g 10001 zapvm \
    && adduser -S -D -H -u 10001 -G zapvm zapvm

COPY --from=build /out/zapvm-control /usr/local/bin/zapvm-control
COPY --from=build /out/zapvm-control-db /usr/local/bin/zapvm-control-db
COPY packaging/railway/entrypoint.sh /usr/local/bin/zapvm-railway-entrypoint
RUN chmod 0755 /usr/local/bin/zapvm-control /usr/local/bin/zapvm-control-db /usr/local/bin/zapvm-railway-entrypoint

EXPOSE 9444

ENTRYPOINT ["/usr/local/bin/zapvm-railway-entrypoint"]
